# Copy this file to ".env" and fill in your Hostinger FTP details.
# Get these from hPanel -> Websites -> aroraarealestate.in -> Files -> FTP Accounts.
# (Create an FTP account for THIS website if you don't have one.)

# FTP hostname (e.g. ftp.aroraarealestate.in  OR  the server hostname Hostinger shows)
FTP_HOST="ftp.aroraarealestate.in"

# FTP username shown in hPanel (often looks like u434085695.aroraarealestate.in)
FTP_USER="REPLACE_ME"

# FTP password you set for that FTP account
FTP_PASS="REPLACE_ME"

# Remote document root for aroraarealestate.in.
# Leave as "public_html" first; the deploy script will VERIFY it is correct
# (it uploads a test file and checks the live URL) and tell you if it's wrong.
# If verification fails, try: domains/aroraarealestate.in/public_html
REMOTE_DIR="public_html"

# Your live site URL used for the post-upload verification check.
SITE_URL="https://aroraarealestate.in"
